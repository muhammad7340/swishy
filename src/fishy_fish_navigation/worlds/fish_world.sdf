<!-- Cylinder Model -->
<model name="cylinder">
  <pose>1.0 0.8 1.1 0 0 0</pose>
  <link name="cylinder_link">
    <collision name="cylinder_collision">
      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.3</length>
        </cylinder>
      </geometry>
    </collision>
    <visual name="cylinder_visual">
      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.3</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>1 0.5 0 1</ambient>
        <diffuse>1 0.5 0 1</diffuse>
      </material>
    </visual>
  </link>
  <static>true</static>
</model>

<!-- Box Model -->
<model name="box">
  <pose>-1.3 0.85 1.0 0 0 0</pose>
  <link name="box_link">
    <collision name="box_collision">
      <geometry>
        <box>
          <size>0.3 0.3 0.3</size>
        </box>
      </geometry>
    </collision>
    <visual name="box_visual">
      <geometry>
        <box>
          <size>0.3 0.3 0.3</size>
        </box>
      </geometry>
      <material>
        <ambient>1 0 0 1</ambient>
        <diffuse>1 0 0 1</diffuse>
      </material>
    </visual>
  </link>
  <static>true</static>
</model>
    
    </world>
</sdf>
