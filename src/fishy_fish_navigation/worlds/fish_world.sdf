<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="fish_world">

        <!-- Keep a deterministic project GUI instead of loading ~/.gz state. -->
        <gui fullscreen="0">
          <plugin filename="MinimalScene" name="3D View">
            <gz-gui>
              <title>3D View</title>
              <property type="bool" key="showTitleBar">false</property>
              <property type="string" key="state">docked</property>
            </gz-gui>
            <engine>ogre2</engine>
            <scene>scene</scene>
            <ambient_light>0.4 0.4 0.4</ambient_light>
            <background_color>0.8 0.8 0.8</background_color>
            <camera_pose>-6 0 6 0 0.5 0</camera_pose>
          </plugin>

          <plugin filename="GzSceneManager" name="Scene Manager">
            <gz-gui>
              <property key="state" type="string">floating</property>
              <property key="width" type="double">5</property>
              <property key="height" type="double">5</property>
              <property key="showTitleBar" type="bool">false</property>
            </gz-gui>
          </plugin>
          <plugin filename="InteractiveViewControl" name="Interactive view control">
            <gz-gui>
              <property key="state" type="string">floating</property>
              <property key="width" type="double">5</property>
              <property key="height" type="double">5</property>
              <property key="showTitleBar" type="bool">false</property>
            </gz-gui>
          </plugin>
          <plugin filename="CameraTracking" name="Camera Tracking">
            <gz-gui>
              <property key="state" type="string">floating</property>
              <property key="width" type="double">5</property>
              <property key="height" type="double">5</property>
              <property key="showTitleBar" type="bool">false</property>
            </gz-gui>
          </plugin>
          <plugin filename="MarkerManager" name="Marker manager">
            <gz-gui>
              <property key="state" type="string">floating</property>
              <property key="width" type="double">5</property>
              <property key="height" type="double">5</property>
              <property key="showTitleBar" type="bool">false</property>
            </gz-gui>
          </plugin>
          <plugin filename="SelectEntities" name="Select Entities">
            <gz-gui>
              <property key="state" type="string">floating</property>
              <property key="width" type="double">5</property>
              <property key="height" type="double">5</property>
              <property key="showTitleBar" type="bool">false</property>
            </gz-gui>
          </plugin>

          <plugin filename="WorldControl" name="World control">
            <gz-gui>
              <title>World control</title>
              <property type="bool" key="showTitleBar">false</property>
              <property type="bool" key="resizable">false</property>
              <property type="double" key="height">72</property>
              <property type="double" key="z">1</property>
              <property type="string" key="state">floating</property>
              <anchors target="3D View">
                <line own="left" target="left"/>
                <line own="bottom" target="bottom"/>
              </anchors>
            </gz-gui>
            <play_pause>true</play_pause>
            <step>true</step>
            <start_paused>false</start_paused>
            <use_event>true</use_event>
          </plugin>

          <plugin filename="WorldStats" name="World stats">
            <gz-gui>
              <title>World stats</title>
              <property type="bool" key="showTitleBar">false</property>
              <property type="bool" key="resizable">false</property>
              <property type="double" key="height">110</property>
              <property type="double" key="width">290</property>
              <property type="double" key="z">1</property>
              <property type="string" key="state">floating</property>
              <anchors target="3D View">
                <line own="right" target="right"/>
                <line own="bottom" target="bottom"/>
              </anchors>
            </gz-gui>
            <sim_time>true</sim_time>
            <real_time>true</real_time>
            <real_time_factor>true</real_time_factor>
            <iterations>true</iterations>
          </plugin>
        </gui>

         <!-- physics settings and plugins  -->
        <physics name='20ms' type='ode'>
          <max_step_size>0.02</max_step_size>
          <real_time_factor>1</real_time_factor>
          <real_time_update_rate>50</real_time_update_rate>
        </physics>
        <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
        <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
        <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
        <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
        <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
          <render_engine>ogre2</render_engine>
        </plugin>
        <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
        <plugin
          filename="gz-sim-navsat-system"
          name="gz::sim::systems::NavSat">
        </plugin>
        <gravity>0 0 -9.8000000000000007</gravity>
 
        <plugin
          filename="gz-sim-buoyancy-system"
          name="gz::sim::systems::Buoyancy">
          <uniform_fluid_density>92.5</uniform_fluid_density>
        </plugin> 

         <!-- lighting settings -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Aquarium spot lights, 0.8 m above the water (z = 2.4). If the
             real-time factor drops below 0.95, turn off shadows on
             kelp_spot first. -->
        <light type="spot" name="focal_spot">
            <visualize>false</visualize>
            <pose>-0.55 0.65 2.4 0 0 0</pose>
            <cast_shadows>true</cast_shadows>
            <diffuse>0.85 0.95 1.0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
            <direction>0 0 -1</direction>
            <attenuation>
                <range>4</range>
                <constant>0.6</constant>
                <linear>0.1</linear>
                <quadratic>0.02</quadratic>
            </attenuation>
            <spot>
                <inner_angle>0.35</inner_angle>
                <outer_angle>0.7</outer_angle>
                <falloff>1.0</falloff>
            </spot>
        </light>

        <light type="spot" name="kelp_spot">
            <visualize>false</visualize>
            <pose>0 1.2 2.4 0 0 0</pose>
            <cast_shadows>true</cast_shadows>
            <diffuse>0.7 0.85 1.0 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>0 0.35 -1</direction>
            <attenuation>
                <range>4</range>
                <constant>0.6</constant>
                <linear>0.1</linear>
                <quadratic>0.02</quadratic>
            </attenuation>
            <spot>
                <inner_angle>0.6</inner_angle>
                <outer_angle>1.1</outer_angle>
                <falloff>1.0</falloff>
            </spot>
        </light>

        <!-- ground plane model -->
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    </plane>
                </geometry>
                </collision>
                <visual name="visual">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    <size>100 100</size>
                    </plane>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
                </visual>
            </link>
            <static>true</static>
        </model>


     <!-- fish tank model designed in blender -->
    <model name="test">
    <link name="testlink">
      <visual name="seashell">
        <geometry>
          <mesh>
            <uri>../models/model.dae</uri>
            <submesh><name>seashell</name></submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.0 0.0 0.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>seashell.jpg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- The original scene uses a full-mesh sand layer beneath the
           per-submesh materials. Keep it visual-only for fast physics. -->
      <visual name="Icosphere">
        <geometry>
          <mesh>
            <uri>../models/model.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.0 0.0 0.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>Sand.jpg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="Cube">
        <geometry>
          <mesh>
            <uri>../models/model.dae</uri>
            <submesh><name>Cube</name></submesh>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.8 1 1</ambient>
          <diffuse>0.5 0.8 1 1</diffuse>
        </material>
      </visual>

      <visual name="Plane">
        <geometry>
          <mesh>
            <uri>../models/model.dae</uri>
            <submesh><name>Plane</name></submesh>
          </mesh>
        </geometry>
        <material>
          <ambient>0.6 0.3 0.1 1</ambient>
          <diffuse>0.6 0.3 0.1 1</diffuse>
        </material>
      </visual>

      <visual name="Object_4">
        <geometry>
          <mesh>
            <uri>../models/model.dae</uri>
            <submesh><name>Object_4</name></submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.0 0.0 0.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>seashell.jpg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="Object_4.003">
        <geometry>
          <mesh>
            <uri>../models/model.dae</uri>
            <submesh><name>Object_4.003</name></submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.0 0.0 0.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>default_baseColor.jpeg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Simple boundaries are much cheaper and more stable than collision
           detection against the full 235k-triangle decorative mesh. -->
      <collision name="north_wall">
        <pose>0 2.05 1 0 0 0</pose>
        <geometry><box><size>4.2 0.1 2</size></box></geometry>
      </collision>
      <collision name="south_wall">
        <pose>0 -2.05 1 0 0 0</pose>
        <geometry><box><size>4.2 0.1 2</size></box></geometry>
      </collision>
      <collision name="east_wall">
        <pose>2.05 0 1 0 0 0</pose>
        <geometry><box><size>0.1 4.2 2</size></box></geometry>
      </collision>
      <collision name="west_wall">
        <pose>-2.05 0 1 0 0 0</pose>
        <geometry><box><size>0.1 4.2 2</size></box></geometry>
      </collision>
    </link>
    <static>true</static>
  </model>

<!-- Aquarium water: visual only (no collision), hidden from lidar/camera
     via visibility flag 0x4. Model origin is the water surface. -->
<include>
  <uri>model://aquarium_water</uri>
  <pose>0 -0.05 1.6 0 0 0</pose>
</include>

<!-- BEGIN aquarium decor (generated by scripts/layout_decor.py) -->
<!-- Back glass backdrop (soft decor) -->
<include>
  <uri>model://backdrop</uri>
  <name>decor_backdrop</name>
  <pose>0.000 1.765 0.800 0 0 0.000</pose>
</include>
<!-- Kelp: soft decor, hidden from the LiDAR (visibility_flags 8) -->
