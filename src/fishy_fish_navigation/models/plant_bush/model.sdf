<?xml version="1.0"?>
<!-- plant_bush: Quaternius Plant_1 (CC0), 0.15 m tall, 0.36 m across (scale 0.2997).
     The OBJ is Y-up, so the visual is rolled 90 deg; model origin = centre of the base.
     Soft decor: no collision; visibility_flags 8 keeps it out of the gpu_lidar. -->
<sdf version="1.8">
  <model name="plant_bush">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <pose>-0.0021 0.0019 0.0034 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/Plant_1.obj</uri>
            <scale>0.2997 0.2997 0.2997</scale>
          </mesh>
        </geometry>
        <visibility_flags>8</visibility_flags>
      </visual>
    </link>
  </model>
</sdf>
