<?xml version="1.0"?>
<!-- starfish: Five-armed starfish, 12 cm across, pink-purple (OpenCV H 158, S 135).
     Generated by scripts/make_decor_assets.py.
     Soft decor: no collision; visibility_flags 8 keeps it out of the gpu_lidar. -->
<sdf version="1.8">
  <model name="starfish">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh><uri>meshes/starfish.obj</uri></mesh>
        </geometry>
        <cast_shadows>true</cast_shadows>
        <visibility_flags>8</visibility_flags>
      </visual>
    </link>
  </model>
</sdf>
