<?xml version="1.0"?>
<!-- seashell_02: Ribbed scallop shell, 5.5 cm, white.
     Generated by scripts/make_decor_assets.py.
     Soft decor: no collision; visibility_flags 8 keeps it out of the gpu_lidar. -->
<sdf version="1.8">
  <model name="seashell_02">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh><uri>meshes/shell.obj</uri></mesh>
        </geometry>
        <cast_shadows>true</cast_shadows>
        <visibility_flags>8</visibility_flags>
      </visual>
    </link>
  </model>
</sdf>
