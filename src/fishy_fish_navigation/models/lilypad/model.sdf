<?xml version="1.0"?>
<!-- lilypad: Quaternius Lilypad (CC0), 0.03 m tall, 0.17 m across (scale 0.1253).
     The OBJ is Y-up, so the visual is rolled 90 deg; model origin = centre of the base.
     Soft decor: no collision; visibility_flags 8 keeps it out of the gpu_lidar. -->
<sdf version="1.8">
  <model name="lilypad">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <pose>-0.0003 -0.0026 -0.0016 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/Lilypad.obj</uri>
            <scale>0.1253 0.1253 0.1253</scale>
          </mesh>
        </geometry>
        <visibility_flags>8</visibility_flags>
      </visual>
    </link>
  </model>
</sdf>
