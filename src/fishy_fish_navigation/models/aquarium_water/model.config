<?xml version="1.0"?>
<model>
  <name>aquarium_water</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <description>
    Visual-only aquarium water for the Swishy fish tank: a tinted, transparent
    water volume plus a rippling Gerstner-wave surface, underwater fog,
    light shafts and shader-animated rising bubbles.
    No collisions; hidden from the gpu_lidar and camera via visibility flag 0x2.
    Wave shaders and textures adapted from VRX (osrf/vrx, Apache 2.0),
    originally from UUV Simulator / Rhys Mainwaring.
  </description>
</model>
