<?xml version="1.0"?>
<!-- aquarium_pump: Open Robotics' "Pump" (Gazebo Fuel, CC BY 4.0) at scale
     0.30 on a slate plinth. Model origin = plinth bottom centre; the pump's
     long axis is +y, its outlet flange at (0, 0.168, 0.405), where
     aquarium_water's bubble stream starts. 0.47 x 0.17 m footprint, 0.41 m
     tall: inside the 0.22 m obstacle circle of the box it replaced. The
     0.20 m plinth puts the gpu_lidar's scan plane (1.15 m in the tank)
     through the middle of the motor and pump housing, so it is mapped;
     with a lower plinth the plane only grazed their tops and the narrow
     coupling, and the scan missed the pump. -->
<sdf version="1.8">
  <model name="aquarium_pump">
    <static>true</static>
    <link name="link">
      <collision name="plinth">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.17 0.47 0.20</size></box></geometry>
      </collision>
      <collision name="pump">
        <pose>0 0 0.3025 0 0 0</pose>
        <geometry><box><size>0.15 0.45 0.205</size></box></geometry>
      </collision>

      <visual name="plinth">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.17 0.47 0.20</size></box></geometry>
        <material>
          <ambient>0.22 0.24 0.26 1</ambient>
          <diffuse>0.3 0.32 0.34 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="pump">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/pump.dae</uri>
            <scale>0.3 0.3 0.3</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/pump_albedo.png</albedo_map>
              <roughness_map>materials/textures/pump_roughness.png</roughness_map>
              <metalness_map>materials/textures/pump_metallic.png</metalness_map>
              <normal_map>materials/textures/pump_normal.png</normal_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
