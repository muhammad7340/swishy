<?xml version="1.0"?>
<model>
  <name>aquarium_pump</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>Ian Chen (Open Robotics), "Pump", Gazebo Fuel, CC BY 4.0</name>
    <email>ichen@openrobotics.org</email>
  </author>

  <description>
    The aquarium's pump: Open Robotics' "Pump" model from Gazebo Fuel
    (https://app.gazebosim.org/OpenRobotics/fuel/models/Pump, CC BY 4.0),
    scaled to 0.30 and set on a slate plinth. Changes: textures resized to
    512 px and the albedo's saturation capped below the colour detector's
    blue range. The bubble stream from its outlet is drawn by aquarium_water.
  </description>
</model>
