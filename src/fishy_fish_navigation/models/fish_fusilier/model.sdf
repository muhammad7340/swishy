<?xml version="1.0"?>
<!-- GENERATED by scripts/make_fish_models.py. Fusilier, 0.2 m long.
     Photogrammetry scan by ffish.asia / floraZia.com (Sketchfab ffishAsia-and-floraZia), CC0 1.0, via github.com/lisa-1002/fishing3d.
     Swims a figure-eight of half-axes 0.55 x 0.4 m around the model
     origin (SwimFish shaders in fish_common); visual only, hidden from the
     gpu_lidar and eye cameras (visibility_flags 4). -->
<sdf version="1.8">
  <model name="fish_fusilier">
    <static>true</static>
    <link name="link">
      <visual name="part0">
        <geometry><mesh><uri>meshes/part0.obj</uri></mesh></geometry>
        <cast_shadows>false</cast_shadows>
        <visibility_flags>4</visibility_flags>
        <plugin filename="gz-sim-shader-param-system" name="gz::sim::systems::ShaderParam">
          <shader language="glsl">
            <vertex>materials/programs/SwimFish_vs_330.glsl</vertex>
            <fragment>materials/programs/SwimFish_fs_330.glsl</fragment>
          </shader>
          <param><shader>vertex</shader><name>worldviewproj_matrix</name></param>
          <param><shader>vertex</shader><name>world_matrix</name></param>
          <param><shader>vertex</shader><name>t</name><value>TIME</value></param>
          <param><shader>vertex</shader><name>bodyLength</name><type>float</type><value>0.2</value></param>
          <param><shader>vertex</shader><name>waveAmp</name><type>float</type><value>0.12</value></param>
          <param><shader>vertex</shader><name>headAmp</name><type>float</type><value>0.15</value></param>
          <param><shader>vertex</shader><name>waveFreq</name><type>float</type><value>2.4</value></param>
          <param><shader>vertex</shader><name>waveCount</name><type>float</type><value>0.8</value></param>
          <param><shader>vertex</shader><name>pattern</name><type>float</type><value>1</value></param>
          <param><shader>vertex</shader><name>radii</name><type>float_array</type><value>0.55 0.4</value></param>
          <param><shader>vertex</shader><name>speed</name><type>float</type><value>0.3</value></param>
          <param><shader>vertex</shader><name>bob</name><type>float</type><value>0.03</value></param>
          <param><shader>fragment</shader><name>albedoMap</name><type>texture</type><value>materials/textures/part0.jpg</value></param>
          <param><shader>fragment</shader><name>lightDir</name><type>float_array</type><value>0.3 -0.4 0.87</value></param>
          <param><shader>fragment</shader><name>ambient</name><type>float</type><value>0.5</value></param>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>
