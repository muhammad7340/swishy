<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swishy_water</name>
  <version>0.1.0</version>
  <description>
    Gazebo system for the Swishy aquarium water: gz-sim's ShaderParam with
    depth writes switched off, so transparent shader effects (fog, caustics,
    bubbles) blend with each other instead of hiding what lies behind them.
  </description>
  <maintainer email="waseemomais@gmail.com">Muhammad Ahtisham</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_rendering_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_common_vendor</depend>
  <depend>sdformat_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
